{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "agent-rules/subagents.md",
    "agent-rules/memory.md",
    "agent-rules/pre-action-checklist.md",
    "agent-rules/repository-language.md"
  ],
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "D:/Source/WeatherHistogram/memory.jsonl"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "{env:REPOSITORY_PATH}"],
      "enabled": true
    }
  }
}
